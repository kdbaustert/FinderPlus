			</array>
		</dict>
	</array>
	<!-- Updates, through Sparkle, from a feed served by GitHub Pages off the gh-pages branch — the
	     same arrangement as Cmd-Tab. The release workflow adds each release's entry to it; the
	     releases themselves carry only the zip. build.sh deletes this key from local builds, so a
	     development copy never updates itself out from under its developer. -->
	<key>SUFeedURL</key>
	<string>https://kdbaustert.github.io/FinderPlus/appcast.xml</string>
	<!-- The public half of the EdDSA key every release is signed with (the same key as Cmd-Tab's;
	     one key serves every app). Sparkle checks each download against it before unpacking, so
	     nobody else can ship FinderPlus's users an update. The private half is in the login
	     keychain, where release.sh's generate_appcast reads it. -->
	<key>SUPublicEDKey</key>
	<string>FYMMALSs2mAccV/rUgQcByyY+mdkpXSBA/nD4JpwvT0=</string>
	<!-- Check daily, but install only when asked; both can be changed in Settings. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSDesktopFolderUsageDescription</key>
